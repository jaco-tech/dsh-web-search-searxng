{
  "name": "@jaco-tech/dsh-web-search-searxng",
  "description": "SearXNG-backed search provider for the DeepSeek Harness web capability seam (ctx.web). No auth, no API key.",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaco-tech/dsh-web-search-searxng.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "searxng",
    "web-search",
    "cordis-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/peer-pins.test.mjs test/smoke.test.mjs",
    "prepublishOnly": "tsc"
  }
}
